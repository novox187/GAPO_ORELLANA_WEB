# Variables del asistente ciudadano (/asistente). Ninguna es obligatoria:
# sin configurar nada, el asistente funciona en modo fase 1 — búsqueda
# semántica sobre el contenido del sitio y ficha oficial armada a partir de
# data/api/v1/, todo dentro de este contenedor.

# ─── Fase 1 ──────────────────────────────────────────────────────────────

# Interruptor de apagado sin redesplegar. Con "false" el endpoint responde
# 503 y la página remite al buscador léxico.
ASISTENTE_ACTIVO=true

# Dónde están los pesos del modelo de embeddings dentro del contenedor.
# El Dockerfile los deja en /app/modelos, que es el valor por defecto.
# RUTA_MODELOS=./modelos

# Permite que el proceso descargue el modelo desde internet si no lo
# encuentra en disco. Debe quedarse en "false" en producción: los pesos
# viajan en la imagen, y un servidor municipal no tiene por qué llamar a un
# tercero durante una consulta ciudadana.
PERMITIR_DESCARGA_MODELO=false

# ─── Fase 2: el párrafo redactado (necesita GPU para ser usable) ─────────

# URL del servicio de modelo local, en la red interna de Docker. Vacío o
# sin definir = fase 1 pura, sin párrafo generado. NUNCA apuntar a un
# servicio fuera de la infraestructura municipal.
# REDACTOR_URL=http://ollama:11434
# REDACTOR_MODELO=qwen3:4b-instruct

# Si el modelo no responde en este tiempo, la ficha se entrega sin párrafo.
# El ciudadano no ve ningún error.
# REDACTOR_TIMEOUT=4000

# --- Backend en Laravel -------------------------------------------------------
# Vacío: el sitio lee los JSON estáticos empaquetados en la imagen, como hasta
# ahora. Con valor: lee de la API, y si la API no responde vuelve a los
# estáticos por su cuenta. Eso permite conmutar y volver atrás sin desplegar.
# El asistente conversacional SÍ necesita esta variable: no tiene respaldo
# estático porque necesita el modelo.
# PUBLIC_API_BASE=http://localhost:8000/api
