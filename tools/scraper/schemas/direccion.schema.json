{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "direccion.schema.json",
  "title": "Dirección municipal",
  "type": "object",
  "required": ["id", "slug", "nombre", "fuente_url"],
  "properties": {
    "id": { "type": "integer" },
    "slug": { "type": "string", "minLength": 1 },
    "nombre": { "type": "string", "minLength": 1 },
    "responsable": { "type": ["string", "null"] },
    "foto": { "type": ["object", "null"] },
    "mision": { "type": "string" },
    "directorio_telefonico": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cargo", "extension"],
        "properties": { "cargo": { "type": "string" }, "extension": { "type": "string" } }
      }
    },
    "fuente_url": { "type": "string", "format": "uri", "minLength": 1 }
  }
}
