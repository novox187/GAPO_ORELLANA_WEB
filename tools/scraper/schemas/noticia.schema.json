{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "noticia.schema.json",
  "title": "Noticia",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["id", "slug", "titulo", "url", "fuente_url"],
      "properties": {
        "id": { "type": "integer" },
        "slug": { "type": "string", "minLength": 1 },
        "titulo": { "type": "string", "minLength": 1 },
        "resumen": { "type": "string" },
        "cuerpo": { "type": "string" },
        "fecha": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "imagen": { "type": ["object", "null"] },
        "imagenes": { "type": "array" },
        "url": { "type": "string", "minLength": 1 },
        "fuente_url": { "type": "string", "format": "uri", "minLength": 1 }
      }
    }
  }
}
