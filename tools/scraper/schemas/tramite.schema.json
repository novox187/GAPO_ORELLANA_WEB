{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tramite.schema.json",
  "title": "Trámite municipal",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "id", "slug", "nombre", "direccion", "categorias", "perfiles",
        "requisitos", "pasos", "formularios", "actualizado_en", "fuente_url",
        "requiere_revision_editorial"
      ],
      "properties": {
        "id": { "type": "integer" },
        "slug": { "type": "string", "minLength": 1 },
        "nombre": { "type": "string", "minLength": 1 },
        "direccion": {
          "type": "object",
          "required": ["id", "slug", "nombre"],
          "properties": {
            "id": { "type": "integer" },
            "slug": { "type": "string" },
            "nombre": { "type": "string" }
          }
        },
        "categorias": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "perfiles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "resumen": { "type": "string" },
        "que_es": { "type": "string" },
        "para_que_sirve": { "type": "string" },
        "quienes_acceden": { "type": "string" },
        "costo": {
          "type": "object",
          "properties": {
            "tiene_costo": { "type": ["boolean", "null"] },
            "detalle": { "type": "string" }
          }
        },
        "requisitos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["orden", "texto"],
            "properties": {
              "orden": { "type": "integer" },
              "texto": { "type": "string" },
              "documento_url": { "type": ["string", "null"], "format": "uri" },
              "obligatorio": { "type": "boolean" }
            }
          }
        },
        "pasos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["orden", "titulo", "descripcion"],
            "properties": {
              "orden": { "type": "integer" },
              "titulo": { "type": "string" },
              "descripcion": { "type": "string" }
            }
          }
        },
        "formularios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nombre", "url", "tipo"],
            "properties": {
              "nombre": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "tipo": { "type": "string" }
            }
          }
        },
        "base_legal": { "type": "array", "items": { "type": "string" } },
        "contenido_adicional": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["titulo", "html"],
            "properties": { "titulo": { "type": "string" }, "html": { "type": "string" } }
          }
        },
        "actualizado_en": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "fuente_url": { "type": "string", "format": "uri", "minLength": 1 },
        "requiere_revision_editorial": { "type": "boolean" }
      }
    }
  }
}
